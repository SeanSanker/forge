{
  "name": "@example/cloudflare-effect-demo",
  "version": "0.0.0",
  "private": true,
  "description": "An unofficial Effect SDK for Cloudflare's API, generated by forge's effect target, and an app using it.",
  "type": "module",
  "scripts": {
    "generate": "sh scripts/generate.sh",
    "start": "node --import ./scripts/register.ts src/main.ts",
    "tour": "node --import ./scripts/register.ts src/live.ts",
    "preview": "node --import ./scripts/register.ts src/preview-main.ts",
    "migrate": "node --import ./scripts/register.ts src/migrate-main.ts",
    "worker": "node --import ./scripts/register.ts src/worker-main.ts",
    "test": "node --import ./scripts/register.ts --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "effect": "4.0.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
